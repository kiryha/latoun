# Copy to .env and adjust if you need non-default paths/ports.
# All values are optional; sensible defaults are used when unset.

# Backend ------------------------------------------------------------------
# Absolute or repo-relative path to the SQLite database file.
LATOUN_DATABASE_PATH=data/latoun.sqlite

# Path to the asset manifest that maps semantic asset keys to GLB files.
LATOUN_ASSET_MANIFEST_PATH=config/wall_plates/asset_manifest.json

# Comma-separated list of allowed CORS origins for the Vite dev server.
LATOUN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend -----------------------------------------------------------------
# Leave empty to use the Vite dev proxy (recommended for local dev).
# Set to e.g. http://localhost:8000 to call the backend directly.
VITE_API_BASE=

# Assembly admin actions (Save Current State / Export JSON). Default: admin.
# Set to false for a public-facing preview that hides those controls.
VITE_ADMIN_MODE=true
